@startuml
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F7F7F7
  BorderColor #999999
}

actor Farmer as F
actor "Admin User" as A
actor "Data/ML Engineer" as M

rectangle "Mobile App" as APP {
  usecase "Capture plant photo" as UC1
  usecase "Crop/Preprocess image" as UC2
  usecase "Submit for diagnosis" as UC3
  usecase "View prediction + confidence" as UC4
  usecase "View Arabic disease names" as UC5
  usecase "View history" as UC6
  usecase "Select online/offline mode" as UC7
  usecase "Sync offline predictions" as UC8
  usecase "Offline queue + sync" as UC9
  usecase "Change language/settings" as UC10
  usecase "View profile" as UC11
}

rectangle "Backend Services" as BE {
  usecase "Image Quality Check" as UC12
  usecase "Disease Classification" as UC13
  usecase "Confidence Scoring" as UC14
  usecase "Disease Metadata Lookup" as UC15
  usecase "Prediction History Save" as UC16
  usecase "Offline Sync Endpoint" as UC17
  usecase "Admin Statistics" as UC18
  usecase "Role-based Admin Access" as UC19
}

rectangle "ML Ops Pipeline" as MLOPS {
  usecase "Merge Datasets" as UC20
  usecase "Label Mapping & QC" as UC21
  usecase "Augment & Split Data" as UC22
  usecase "Train & Evaluate Model" as UC23
  usecase "Track Runs with MLflow" as UC24
  usecase "Save Checkpoint + Manifest" as UC25
  usecase "Export ONNX Offline Model" as UC26
  usecase "Rank Candidate Models" as UC27
}

rectangle "Admin Panel" as EXP {
  usecase "View Users" as UC28
  usecase "View Predictions" as UC29
  usecase "Manage Disease Metadata" as UC30
  usecase "View Dashboard Stats" as UC31
}

